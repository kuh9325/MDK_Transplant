; MDK Phase 7 (G1) — Godot 4 frontend. Engine config only; all game
; data is resolved at runtime through the GDExtension bridge.

config_version=5

[application]

config/name="MDK"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")
config/use_custom_user_dir=true
config/custom_user_dir_name="MDK"

[display]

window/size/viewport_width=1280
window/size/viewport_height=768

[rendering]

; Textures arrive palette-expanded; keep the default nearest-friendly
; configuration — the arena shader uses texelFetch regardless.

; macOS arm64 export requires the ETC2/ASTC import option enabled
; even though this project imports no textures.
textures/vram_compression/import_etc2_astc=true
